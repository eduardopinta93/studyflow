generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model User {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  name       String
  email      String   @unique
  password   String
  role       String   @default("USER")
  major      String?
  year       String?
  studyGoal  String?
  avatarUrl  String?
  categoryId String?  @db.ObjectId
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  category    StudyCategory? @relation(fields: [categoryId], references: [id])
  courses     Course[]
  assignments Assignment[]
  sentMessages     Message[] @relation("MessageSender")
  receivedMessages Message[] @relation("MessageRecipient")
}

model StudyCategory {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  name        String   @unique
  description String?
  color       String   @default("#0078D4")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  courseUnits CourseUnit[]
  users       User[]
}

model CourseUnit {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  code        String   @unique
  name        String
  credits     Int
  description String?
  color       String?
  categoryId  String   @db.ObjectId
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  category    StudyCategory        @relation(fields: [categoryId], references: [id])
  assignments AssignmentTemplate[]
}

model AssignmentTemplate {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  title        String
  description  String?
  content      String?
  points       Int      @default(10)
  dueInDays    Int
  type         String   @default("assignment")
  priority     String   @default("medium")
  courseUnitId String   @db.ObjectId
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  courseUnit CourseUnit @relation(fields: [courseUnitId], references: [id])
}

model Course {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  name      String
  code      String?
  term      String?
  notes     String?
  color     String?  @default("#154920")
  userId    String   @db.ObjectId
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user        User         @relation(fields: [userId], references: [id])
  assignments Assignment[]
  announcements   Announcement[]
  discussionTopics DiscussionTopic[]
}

model Announcement {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  title      String
  message    String
  authorName String   @default("Instructor")
  courseId   String   @db.ObjectId
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  course Course @relation(fields: [courseId], references: [id])

  @@index([courseId])
}

model DiscussionTopic {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  title      String
  message    String
  authorName String   @default("Instructor")
  pinned     Boolean  @default(false)
  locked     Boolean  @default(false)
  courseId   String   @db.ObjectId
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  course  Course            @relation(fields: [courseId], references: [id])
  entries DiscussionEntry[]

  @@index([courseId])
}

model DiscussionEntry {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  message    String
  authorName String
  topicId    String   @db.ObjectId
  parentId   String?  @db.ObjectId
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  topic   DiscussionTopic    @relation(fields: [topicId], references: [id])
  parent  DiscussionEntry?   @relation("EntryReplies", fields: [parentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  replies DiscussionEntry[]  @relation("EntryReplies")

  @@index([topicId])
  @@index([parentId])
}

model Assignment {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  title       String
  description String?
  content     String?
  points      Int      @default(10)
  dueDate     DateTime
  completed   Boolean  @default(false)
  type        String   @default("assignment")
  priority    String   @default("medium")
  courseId    String   @db.ObjectId
  userId      String   @db.ObjectId
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  course Course @relation(fields: [courseId], references: [id])
  user   User   @relation(fields: [userId], references: [id])
}

model Message {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  subject     String
  body        String
  senderId    String?  @db.ObjectId
  senderName  String   @default("Instructor")
  recipientId String   @db.ObjectId
  read        Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  sender    User? @relation("MessageSender", fields: [senderId], references: [id])
  recipient User  @relation("MessageRecipient", fields: [recipientId], references: [id])

  @@index([recipientId])
  @@index([senderId])
}
