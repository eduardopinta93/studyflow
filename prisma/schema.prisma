generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model User {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  name       String
  email      String   @unique
  password   String
  major      String?
  year       String?
  studyGoal  String?
  avatarUrl  String?
  categoryId String?  @db.ObjectId
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  category    StudyCategory? @relation(fields: [categoryId], references: [id])
  courses     Course[]
  assignments Assignment[]
}

model StudyCategory {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  name        String   @unique
  description String?
  color       String   @default("#4F46E5")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  courseUnits CourseUnit[]
  users       User[]
}

model CourseUnit {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  code        String   @unique
  name        String
  credits     Int
  description String?
  color       String?
  categoryId  String   @db.ObjectId
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  category    StudyCategory        @relation(fields: [categoryId], references: [id])
  assignments AssignmentTemplate[]
}

model AssignmentTemplate {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  title        String
  description  String?
  content      String?
  points       Int      @default(10)
  dueInDays    Int
  type         String   @default("assignment")
  priority     String   @default("medium")
  courseUnitId String   @db.ObjectId
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  courseUnit CourseUnit @relation(fields: [courseUnitId], references: [id])
}

model Course {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  name      String
  code      String?
  term      String?
  notes     String?
  color     String?  @default("#4F46E5")
  userId    String   @db.ObjectId
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user        User         @relation(fields: [userId], references: [id])
  assignments Assignment[]
}

model Assignment {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  title       String
  description String?
  content     String?
  points      Int      @default(10)
  dueDate     DateTime
  completed   Boolean  @default(false)
  type        String   @default("assignment")
  priority    String   @default("medium")
  courseId    String   @db.ObjectId
  userId      String   @db.ObjectId
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  course Course @relation(fields: [courseId], references: [id])
  user   User   @relation(fields: [userId], references: [id])
}
